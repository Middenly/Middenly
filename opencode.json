{
  "$schema": "https://opencode.ai/config.json",
  "logLevel": "DEBUG",
  "model": "xiaomi/mimo-v2.5-pro",
  "default_agent": "build",
  "instructions": ["AGENTS.md"],

  "provider": {
    "xiaomi": {
      "name": "Xiaomi MiMo",
      "api": "openai",
      "options": {
        "baseURL": "https://token-plan-cn.xiaomimimo.com/v1",
        "apiKey": "tp-sskzzyk12kd6bjvrarlfkof7phngdcng0ejg1jf9dllpee40",
        "timeout": false,
        "headerTimeout": false,
        "chunkTimeout": 600000
      },
      "models": {
        "mimo-v2.5-pro": {
          "id": "mimo-v2.5-pro",
          "name": "MiMo v2.5 Pro",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 32000
          }
        }
      }
    }
  },

  "agent": {
    "build": {
      "model": "xiaomi/mimo-v2.5-pro",
      "steps": 500,
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "task": "allow",
        "external_directory": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "plan": {
      "model": "xiaomi/mimo-v2.5-pro",
      "steps": 300,
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow"
      }
    }
  },

  "compaction": {
    "auto": true,
    "tail_turns": 20,
    "preserve_recent_tokens": 50000
  },

  "experimental": {
    "mcp_timeout": 60000
  },

  "tool_output": {
    "max_lines": 500,
    "max_bytes": 102400
  }
}
